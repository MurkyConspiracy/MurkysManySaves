<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <SignAssembly>False</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\Probably Stolen_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\Probably Stolen_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\Probably Stolen_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\Probably Stolen_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\..\Probably Stolen_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\Probably Stolen_Data\Managed\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\..\Probably Stolen_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="BumpModVersion" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\bump-version.ps1&quot; -ManifestPath &quot;$(ProjectDir)manifest.xml&quot;" />
  </Target>

  <Target Name="CopyDllAndManifest" AfterTargets="Build">
    <ItemGroup>
      <MainDll Include="$(TargetPath)" />
      <ManifestFile Include="$(ProjectDir)manifest.xml" />
    </ItemGroup>

    <PropertyGroup>
      <ModOutputDir>$(ProjectDir)..\..\Mods\MurkysManySaves\</ModOutputDir>
    </PropertyGroup>

    <Copy SourceFiles="@(MainDll)" DestinationFolder="$(ModOutputDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ManifestFile)" DestinationFolder="$(ModOutputDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
